# =============================================================================
#  Copy this file to `.env` and fill in the values:
#
#      cp .env.example .env
#
#  `.env`         -> holds real secrets, is gitignored, NEVER committed
#  `.env.example` -> holds empty placeholders, IS committed, tells your
#                    teammates which variables they need to set
#
#  In production these same values go into your host's environment variable
#  panel (Render -> your service -> Environment), not into a file.
# =============================================================================


# --- Google Gemini -----------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=

# Which model to use.
#
# `gemini-flash-latest` is an alias Google keeps pointed at the current free
# Flash model. Model names get retired, and a retired name gives you a confusing
# 404 rather than a useful error — the alias sidesteps that.
#
# Pin a specific version (e.g. gemini-3-flash-preview) if you'd rather the model
# stop changing under you. Check https://aistudio.google.com for what's current.
GEMINI_MODEL=gemini-flash-latest


# --- Supabase ----------------------------------------------------------------
# Fastest route to both values: the "Connect" button at the top of your project
# dashboard. Otherwise:
#   URL  -> Integrations > Data API
#   Keys -> Settings > API Keys

# Looks like: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The SECRET key, from the "API Keys" tab. Starts with `sb_secret_`.
#
# Supabase replaced the old JWT keys with a clearer pair. Same two jobs, new
# names — and the new keys are plain opaque strings, not JWTs:
#
#   sb_publishable_...  safe in a browser   (was: anon)
#   sb_secret_...       server-side ONLY    (was: service_role)
#
# If your project is older it may only have the legacy pair, on the "Legacy API
# Keys" tab. Those keep working until Supabase retires them at the end of 2026;
# paste the service_role key here and it's fine. New project? Use sb_secret_.
#
# ⚠️  The secret key BYPASSES all Row Level Security.
#     It belongs on your server and nowhere else. If it ever touches frontend
#     code, a git commit, a screenshot, or a chat message: rotate it immediately.
#     Rotating is now a real fix — you can delete one secret key without
#     invalidating anything else, which the old service_role key never allowed.
SUPABASE_SECRET_KEY=


# --- CORS --------------------------------------------------------------------
# Which website origins are allowed to call this API from a browser.
# Comma-separated, no trailing slash. Use * only while developing.
#
# Real example once your frontend is on GitHub Pages:
#   ALLOWED_ORIGINS=https://yourname.github.io,http://localhost:8080
ALLOWED_ORIGINS=*


# --- Tuning (optional) -------------------------------------------------------
# Hard ceiling on agent steps. Without this, a confused agent can loop forever
# and burn your entire daily quota in one run.
MAX_AGENT_STEPS=12
