# =============================================================================
#  Copy this file to `.env` and fill in the values:
#
#      cp .env.example .env
#
#  `.env`         -> holds real secrets, is gitignored, NEVER committed
#  `.env.example` -> holds empty placeholders, IS committed, tells your
#                    teammates which variables they need to set
#
#  In production these same values go into your host's environment variable
#  panel (Render -> your service -> Environment), not into a file.
# =============================================================================


# --- The model ---------------------------------------------------------------
# Leave this section alone to use Gemini, which is what the workshop assumes.
# Get a free key at https://aistudio.google.com/apikey  (no credit card)
LLM_API_KEY=

# Which model to use.
#
# `gemini-flash-latest` is an alias Google keeps pointed at the current free
# Flash model. Model names get retired, and a retired name gives you a confusing
# 404 rather than a useful error — the alias sidesteps that.
#
# Pin a specific version (e.g. gemini-3-flash-preview) if you'd rather the model
# stop changing under you. Check https://aistudio.google.com for what's current.
LLM_MODEL=gemini-flash-latest

# Older copies of this project called the two variables above GEMINI_API_KEY and
# GEMINI_MODEL. Those still work when LLM_PROVIDER is google, so an existing
# .env or a deployed service keeps running untouched.


# --- Switching provider (optional) -------------------------------------------
# Free keys rate-limit, and "my key died mid-demo" shouldn't end your session.
# Every option below is free without a credit card. Set LLM_PROVIDER, then put
# that provider's key in LLM_API_KEY and one of its model names in LLM_MODEL.
#
#   google             (default)  https://aistudio.google.com/apikey
#   cerebras                      https://cloud.cerebras.ai
#   openrouter                    https://openrouter.ai/models?max_price=0
#                                 One key, many models. Free ones are throttled.
#   openai-compatible             Anything speaking the OpenAI shape — Groq,
#                                 Together, Mistral. Also needs LLM_BASE_URL.
#
# GitHub Models is NOT here: it was retired on 30 July 2026. If you find a
# tutorial recommending it, that tutorial is out of date — which is the whole
# reason this file dates its claims.
#
# There is no default model for the non-Google providers on purpose: their
# catalogues change, and a stale name we guessed would 404 at you months later.
#
# A bigger list of who's giving away what, kept far more current than this file:
#   https://github.com/cheahjs/free-llm-api-resources
LLM_PROVIDER=google

# Only for LLM_PROVIDER=openai-compatible. For example, to use Groq:
#   LLM_PROVIDER=openai-compatible
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=


# --- Web search (optional) ---------------------------------------------------
# Leave this blank and everything still works — the agent researches with
# Wikipedia alone, exactly as the workshop's early steps describe.
#
# Fill it in and the agent also gets `tavily_search`, which reads the live web.
# That's the difference between "I can tell you how solar panels work" and "I can
# tell you what was announced this week" — Wikipedia is written after the fact,
# and a model's own knowledge stops at its training cutoff.
#
# We reach Tavily over MCP, at their hosted server, which makes this app an MCP
# *client* as well as an MCP *server*. See app/agent/research.py.
#
# Free key, 1,000 searches a month, no credit card: https://app.tavily.com
# Starts with `tvly-`.
TAVILY_API_KEY=


# --- Supabase ----------------------------------------------------------------
# Fastest route to both values: the "Connect" button at the top of your project
# dashboard. Otherwise:
#   URL  -> Integrations > Data API
#   Keys -> Settings > API Keys

# Looks like: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The SECRET key, from the "API Keys" tab. Starts with `sb_secret_`.
#
# Supabase replaced the old JWT keys with a clearer pair. Same two jobs, new
# names — and the new keys are plain opaque strings, not JWTs:
#
#   sb_publishable_...  safe in a browser   (was: anon)
#   sb_secret_...       server-side ONLY    (was: service_role)
#
# If your project is older it may only have the legacy pair, on the "Legacy API
# Keys" tab. Those keep working until Supabase retires them at the end of 2026;
# paste the service_role key here and it's fine. New project? Use sb_secret_.
#
# ⚠️  The secret key BYPASSES all Row Level Security.
#     It belongs on your server and nowhere else. If it ever touches frontend
#     code, a git commit, a screenshot, or a chat message: rotate it immediately.
#     Rotating is now a real fix — you can delete one secret key without
#     invalidating anything else, which the old service_role key never allowed.
SUPABASE_SECRET_KEY=


# --- CORS --------------------------------------------------------------------
# Which website origins are allowed to call this API from a browser.
# Comma-separated, no trailing slash. Use * only while developing.
#
# Real example once your frontend is on GitHub Pages:
#   ALLOWED_ORIGINS=https://yourname.github.io,http://localhost:8080
ALLOWED_ORIGINS=*


# --- Tuning (optional) -------------------------------------------------------
# Hard ceiling on agent steps. Without this, a confused agent can loop forever
# and burn your entire daily quota in one run.
MAX_AGENT_STEPS=12

# Hard ceiling on turns in one conversation. Every turn re-sends the whole
# history, so a long thread costs more per question than a short one and
# eventually stops fitting in the context window at all. This turns that into a
# clear "start a new conversation" instead of a mystery failure.
MAX_THREAD_TURNS=10
