# Copy to .env and edit. Only VITE_-prefixed vars reach the browser.
#
# ⚠️  ANYTHING IN THIS FILE IS PUBLIC once the app is built. Vite inlines these
#     values into the JavaScript bundle — "environment variable" does not mean
#     "secret" in a frontend. View-source shows every one of them.
#
#     So: no Gemini key, no Supabase key, no anything-secret. Ever. Those live
#     on the server, in app/.env. The browser calls your API; your API holds
#     the keys. That's the whole security model.

# Where your FastAPI backend lives. Local dev default is http://localhost:8000.
# In production this is your Render URL, e.g. https://your-service.onrender.com
# A URL is not a secret, which is why this one is fine to ship.
VITE_API_URL=http://localhost:8000
